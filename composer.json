{
    "name": "dragoncore/dragon-content-decay",
    "description": "Identify content losing traffic over time by connecting to Google Analytics 4",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Dragon Core",
            "email": "hello@dcplugins.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "google/apiclient": "^2.15"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "DragonContentDecay\\": "includes/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress includes/",
        "lint:fix": "phpcbf --standard=WordPress includes/"
    }
}
